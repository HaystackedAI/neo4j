# Copy to .env and fill in. .env is gitignored; this template is committed.
# Keep both blocks and comment out the one you are not using -- chapters move
# between hosts (CSV chapters on Aura, .dump chapters on local Desktop).

# --- Aura: credentials come from the file Aura gives you at instance creation
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Local Neo4j Desktop DBMS: password is the one set when creating it
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# Bedrock region and model ids have sensible defaults in config.py and need
# nothing here. Credentials are resolved by boto3's own chain, never from .env.
# Override only if necessary:
# BEDROCK_REGION=us-east-1
# BEDROCK_TEXT_MODEL=amazon.nova-micro-v1:0
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
